# From @BotFather when you created the bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere

# Numeric chat id of your channel (bot must be an ADMIN of this channel).
# For public channels you can usually use @channelusername instead.
TELEGRAM_CHANNEL_ID=-1001234567890

# Public (browser-visible) values — used by the bridge page AND the
# webhook's "Join Channel" button
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername
NEXT_PUBLIC_TELEGRAM_CHANNEL_LINK=https://t.me/yourchannel
